{
  "$schema": "https://mosvera.io/schema/0.1/template",
  "id": "nova-glass",
  "palette": {
    "surface": "#1C1C1E",
    "surface_alt": "#26262A",
    "background": "#121214",
    "border": "#4A7FA5",
    "accent": "#C9933A",
    "accent_2": "#8ABAD3",
    "ink": "#F2F2F4",
    "muted": "#9A9AA0",
    "code_bg": "#101012",
